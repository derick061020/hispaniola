# URL del Odoo que sirve la API de reservas (modulo `hispaniola_web`).
#
# Es la UNICA variable de entorno del proyecto. Sin ella el cliente cae a
# http://localhost:8069, que es lo que hace falta en desarrollo.
#
# Copiar a `.env.local` para trabajar en local (ese archivo esta en .gitignore
# por el `*.local`). En Vercel se pone en Settings > Environment Variables.
#
# ⚠️ El dominio tiene que estar dado de alta en Odoo:
#    Ajustes > Hispaniola Web > Allowed origins (CORS)
#    Si no, el navegador bloquea todas las llamadas.
VITE_API_URL=http://localhost:8069
